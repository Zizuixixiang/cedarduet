+            if bus:
+                return bus[-1]
+        filtered = [a for a in actions if a['action'] not in ('take_loan', 'repay_loan', 'use_bus', 'use_item')]
+        if p['jailed'] and state['phase'] == 'roll' and p['jail_turns'] >= 1:
+            pay = next((a for a in filtered if a['action'] == 'pay_bail'), None)
+            if pay:
