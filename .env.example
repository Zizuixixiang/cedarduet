# Ordinary two-player games work with the default disabled provider.
DUEL_NPC_PROVIDER=disabled

# Standalone OpenAI-compatible provider (server-side only).
# DUEL_NPC_PROVIDER=openai_compatible
# DUEL_NPC_API_BASE=https://your-provider.example/v1
# DUEL_NPC_API_KEY=replace-with-your-own-secret
# DUEL_NPC_MODEL=your-model

# Official CedarToy loopback bridge alternative.
# DUEL_NPC_PROVIDER=cedartoy_bridge
# DUEL_NPC_BRIDGE_URL=http://127.0.0.1:8012/internal/duel/npc-decision
# DUEL_NPC_BRIDGE_TOKEN=replace-with-a-shared-internal-secret

DUEL_NPC_TIMEOUT_SECONDS=20
DUEL_NPC_MAX_TOKENS=512
DUEL_NPC_MAX_CONCURRENCY=4
DUEL_NPC_PERSONAS_DIR=/srv/cedarduet/personas
DUEL_NPC_AVATARS_DIR=/srv/cedarduet/npc-avatars
