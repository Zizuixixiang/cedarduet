[program:cedarduet]
command=/srv/cedarduet/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8772
directory=/srv/cedarduet
environment=DUEL_DB_PATH="/srv/cedarduet/data/duel.db"
autostart=true
autorestart=true
stopsignal=TERM
stopasgroup=true
killasgroup=true
stderr_logfile=/var/log/cedarduet.err.log
stdout_logfile=/var/log/cedarduet.out.log
numprocs=1
