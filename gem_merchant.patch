+/* 宝石商人：沿用双弈的粉紫像素配色；所有卡面、宝石、称号卡都是 CSS 原创绘制。 */
+.board.gem_merchant {
+  display: block;
+  width: 100%;
+  max-width: 100%;
+  min-width: 0;
+  height: auto;
+  aspect-ratio: auto;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  box-shadow: none;
+  touch-action: manipulation;
+}
+
+#battleStage[data-game-type="gem_merchant"] .board-zone,
+#battleStage[data-game-type="gem_merchant"] .board-frame,
+#battleStage[data-game-type="gem_merchant"] .board,
+#battleStage[data-game-type="gem_merchant"] .game-controls {
+  width: min(100%, 520px);
+  max-width: 100%;
+  min-width: 0;
+  margin-inline: auto;
+}
+
+.gm-game,
+.gm-game *,
+.gm-controls,
+.gm-controls * { box-sizing: border-box; }
+
+.gm-game,
+.gm-controls {
+  width: 100%;
+  min-width: 0;
+  color: var(--text, #5C5463);
+  font: 13px/1.4 system-ui, -apple-system, "PingFang SC", sans-serif;
+  text-align: left;
+}
+
+.gm-game { display: grid; gap: 8px; }
+
+/* ---------- 宝石 ---------- */
+.gem-white { --gm-hi: #fffdf8; --gm-mid: #ebe4d6; --gm-lo: #a99f8b; --gm-ink: #5a5446; }
+.gem-blue { --gm-hi: #a7cff5; --gm-mid: #4a8fd9; --gm-lo: #2b5f9e; --gm-ink: #fff; }
+.gem-green { --gm-hi: #b0ddb7; --gm-mid: #5ea86a; --gm-lo: #38703f; --gm-ink: #fff; }
+.gem-red { --gm-hi: #f6b0a6; --gm-mid: #d9574a; --gm-lo: #9c3027; --gm-ink: #fff; }
+.gem-black { --gm-hi: #8f8a85; --gm-mid: #3d3a37; --gm-lo: #151413; --gm-ink: #fff; }
+.gem-pearl { --gm-hi: #ffffff; --gm-mid: #f3dbe4; --gm-lo: #cf9cb0; --gm-ink: #7a4b5c; }
+.gem-gold { --gm-hi: #fde6a6; --gm-mid: #e3a13a; --gm-lo: #a86a12; --gm-ink: #fff; }
