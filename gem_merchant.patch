+    (2, "*", 1, 2, 0, "joker", "g6 p1"),
+    (2, "*", 1, 0, 2, "joker", "g6 p1"),
+    (2, "*", 1, 0, 2, "joker", "u6 p1"),
+    (3, "k", 1, 3, 2, "", "w3 g5 r3 p1"),
+    (3, "k", 1, 4, 0, "", "w2 r2 k6"),
+    (3, "r", 1, 3, 2, "", "u5 g3 k3 p1"),
+    (3, "r", 1, 4, 0, "", "g2 r6 k2"),
