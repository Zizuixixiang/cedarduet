+  box-shadow: inset 0 -2px 0 rgba(0, 0, 0, .12);
+}
+
+.gm-facet {
+  position: absolute;
+  inset: 20%;
+  clip-path: polygon(50% 0, 100% 26%, 100% 74%, 50% 100%, 0 74%, 0 26%);
+  background:
+    linear-gradient(200deg, rgba(255, 255, 255, .7) 0 32%, transparent 33%),
+    linear-gradient(160deg, var(--gm-hi), var(--gm-mid) 58%, var(--gm-lo));
+}
+
+.gm-gem.gem-pearl .gm-facet {
+  inset: 18% 46% 52% 20%;
+  clip-path: none;
+  border-radius: 50%;
+  background: #fff;
+  opacity: .85;
+}
+
+.gm-gem.gem-gold .gm-facet {
+  inset: 30% 22% 30% 22%;
+  clip-path: polygon(0 100%, 0 20%, 25% 55%, 50% 0, 75% 55%, 100% 20%, 100% 100%);
+  background: #fff4d0;
+  opacity: .92;
+}
+
+.gm-gem.is-small { width: 16px; height: 16px; }
+.gm-gem.is-mini { width: 32cqw; height: 32cqw; max-width: 18px; max-height: 18px; }
+
+/* ---------- 状态行 ---------- */
+.gm-status {
+  min-height: 30px;
+  padding: 5px 8px;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
