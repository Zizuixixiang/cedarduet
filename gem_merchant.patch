+
+.gm-meters { display: flex; gap: 6px; flex: none; }
+.gm-meter { min-width: 40px; display: grid; justify-items: center; font-size: 10px; color: #8d8297; }
+.gm-meter strong { color: var(--text, #5C5463); font-size: 15px; line-height: 1.1; }
+.gm-meter-bar { width: 100%; height: 3px; background: var(--purple-light, #E6DFF0); position: relative; overflow: hidden; }
+.gm-meter-bar::after { content: ""; position: absolute; inset: 0 auto 0 0; width: var(--fill, 0%); background: var(--pink, #E6A8B1); }
+
+.gm-token-row,
+.gm-bonus-row { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; }
+.gm-token-chip { display: inline-flex; align-items: center; gap: 2px; min-width: 28px; font-weight: 700; font-size: 12px; }
+.gm-token-chip.is-zero { opacity: .3; }
+.gm-privileges { display: inline-flex; align-items: center; gap: 2px; padding-left: 6px; border-left: 1px solid var(--purple-light, #E6DFF0); font-weight: 700; font-size: 12px; }
+.gm-token-total { margin-left: auto; font-size: 11px; color: #8d8297; }
+.gm-token-total.is-over { color: #c0473b; font-weight: 700; }
+
+.gm-bonus-box {
