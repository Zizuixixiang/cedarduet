+    (2, "g", 1, 2, 1, "", "w2 u2 k2 p1"),
+    (2, "g", 1, 2, 0, "scroll", "u2 g4 p1"),
+    (2, "u", 1, 1, 0, "steal", "g4 k3"),
+    (2, "u", 2, 1, 0, "", "g5 r2"),
+    (2, "u", 1, 2, 1, "", "w2 r2 k2 p1"),
+    (2, "u", 1, 2, 0, "scroll", "w2 u4 p1"),
+    (2, "w", 1, 1, 0, "steal", "u4 r3"),
+    (2, "w", 2, 1, 0, "", "u5 g2"),
