+"""宝石商人（gem_merchant）：规则单测、随机整局、隐私与 MCP 集成。"""
+import json
+import random
+import re
+import tempfile
+import unittest
+from collections import Counter
+from copy import deepcopy
+from pathlib import Path
+from unittest.mock import patch
+
+import httpx
