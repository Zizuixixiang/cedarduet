+.gm-royal-tag { padding: 1px 5px; border: 1px solid #d8b56a; background: #fff3d6; color: #6b4b12; font-size: 11px; }
+.gm-muted { color: #9a90a4; font-size: 11px; }
+
+.gm-reserved { display: flex; align-items: center; gap: 5px; }
+.gm-reserved-label { writing-mode: vertical-rl; font-size: 10px; color: #9a90a4; letter-spacing: 2px; }
+
+/* ---------- 图标 ---------- */
+.gm-crown-icon {
+  width: 13px;
+  height: 10px;
+  display: inline-block;
+  flex: none;
+  background: linear-gradient(#f3c955, #d89b1f);
+  clip-path: polygon(0 100%, 0 18%, 26% 52%, 50% 0, 74% 52%, 100% 18%, 100% 100%);
+}
+.gm-scroll-icon {
+  width: 11px;
+  height: 14px;
+  display: inline-block;
+  flex: none;
+  border: 1px solid #b8945a;
+  border-radius: 3px 3px 5px 5px;
+  background:
+    linear-gradient(#b8945a, #b8945a) 2px 4px / 5px 1px no-repeat,
+    linear-gradient(#b8945a, #b8945a) 2px 7px / 4px 1px no-repeat,
+    #f6e7c6;
+}
+
+/* ---------- 称号卡 ---------- */
+.gm-royals { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 5px; }
+.gm-royal {
+  min-width: 0;
+  min-height: 48px;
+  padding: 4px;
+  display: grid;
+  grid-template-columns: auto minmax(0, 1fr) auto;
+  align-items: center;
+  column-gap: 4px;
+  border: 2px solid #e5c98c;
+  background: linear-gradient(160deg, #fff8e6, #f8e3b8);
+  color: #6b4b12;
+  font: inherit;
+  text-align: left;
+}
+button.gm-royal { cursor: pointer; border-color: #c99a2a; box-shadow: 0 0 0 2px #fff, 0 0 0 4px #f0c95a; }
+.gm-royal.is-selected { background: #fff; box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--purple-darker, #8678A0); }
+.gm-royal-emblem {
+  width: 20px;
+  height: 20px;
+  display: grid;
+  place-items: center;
+  border: 1px solid #c99a2a;
+  background: #fff;
+  font-size: 11px;
+  font-weight: 800;
+}
+.gm-royal-body { min-width: 0; display: grid; }
+.gm-royal-name { font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.gm-royal-ability { font-size: 9px; line-height: 1.2; opacity: .85; }
+.gm-royal-short { display: none; font-size: 9px; line-height: 1.2; opacity: .85; }
+.gm-royal-points { font-size: 14px; font-weight: 800; }
+
+/* ---------- 发展卡 ---------- */
+.gm-pyramid { display: grid; gap: 5px; }
+.gm-pyramid-row { display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: 5px; align-items: stretch; }
+.gm-pyramid-cards { min-width: 0; display: flex; justify-content: center; gap: 4px; }
+.gm-pyramid-cards > .gm-card { flex: 0 0 calc((100% - 16px) / 5); width: calc((100% - 16px) / 5); }
+
+.gm-deck {
+  min-height: 44px;
+  padding: 2px;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  border: 2px solid var(--purple, #BEB1D1);
+  background: repeating-linear-gradient(135deg, var(--purple-light, #E6DFF0) 0 5px, #fff 5px 10px);
+  color: var(--purple-darker, #8678A0);
+  font: inherit;
+  font-size: 11px;
+  touch-action: manipulation;
+}
+.gm-deck strong { font-size: 14px; color: var(--text, #5C5463); }
+.gm-deck .gm-level { position: static; font-size: 8px; letter-spacing: 0; color: var(--purple-darker, #8678A0); }
+.gm-deck:disabled { opacity: .75; cursor: default; }
+.gm-deck.can-reserve { border-color: #d89b1f; }
+.gm-deck.is-focused { box-shadow: 0 0 0 3px var(--purple-darker, #8678A0); }
+
+.gm-card {
+  --gm-tint: #f6f0e1;
+  position: relative;
+  min-width: 0;
+  aspect-ratio: 5 / 7;
+  padding: 0;
+  display: block;
+  overflow: hidden;
+  container-type: inline-size;
+  border: 2px solid rgba(92, 84, 99, .25);
+  background: var(--gm-tint);
+  color: var(--text, #5C5463);
+  font: inherit;
+  text-align: left;
+  touch-action: manipulation;
+}
+button.gm-card { cursor: pointer; }
+.gm-card.tint-white { --gm-tint: #fbf8f1; }
+.gm-card.tint-blue { --gm-tint: #e3eefa; }
+.gm-card.tint-green { --gm-tint: #e5f2e6; }
+.gm-card.tint-red { --gm-tint: #f9e3df; }
+.gm-card.tint-black { --gm-tint: #e2dfdc; }
+.gm-card.tint-none { --gm-tint: #f6efdc; }
+.gm-card.is-joker {
+  background: linear-gradient(135deg, #f9e3df, #fbf8f1 25%, #e5f2e6 50%, #e3eefa 75%, #e2dfdc);
+}
+.gm-card.lv-2 { border-style: double; border-width: 3px; }
+.gm-card.lv-3 { border-color: rgba(201, 154, 42, .7); }
+.gm-card.is-empty { border: 2px dashed var(--purple-light, #E6DFF0); background: transparent; }
+.gm-card.is-back {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 4px;
+  border-color: var(--purple-dark, #9B8DB5);
+  background: repeating-linear-gradient(45deg, #d8cfe6 0 6px, #e9e3f2 6px 12px);
+  color: #5d4f73;
+}
+.gm-back-mark { font-size: 18cqw; font-weight: 800; letter-spacing: 1px; }
+.gm-card.can-buy { border-color: #5ea86a; box-shadow: 0 0 0 2px rgba(94, 168, 106, .35); }
+.gm-card.can-reserve { border-color: #d89b1f; }
+.gm-card.is-focused { border-color: var(--purple-darker, #8678A0); box-shadow: 0 0 0 3px var(--purple-darker, #8678A0); transform: translateY(-2px); }
+.gm-card.is-blind-own::after {
+  content: "盲";
+  position: absolute;
+  right: 2px;
+  top: 30%;
+  padding: 0 2px;
+  background: var(--purple-dark, #9B8DB5);
+  color: #fff;
+  font-size: 16cqw;
+}
+
+.gm-card-top {
+  position: absolute;
+  inset: 0 0 auto 0;
+  height: 28%;
+  padding: 3cqw 4cqw;
+  display: flex;
+  align-items: flex-start;
+  gap: 2cqw;
+  background: rgba(255, 255, 255, .6);
+}
+.gm-points { font-size: 30cqw; font-weight: 900; line-height: 1; }
+.gm-points.is-zero { visibility: hidden; }
+.gm-card-crowns { display: inline-flex; align-items: center; gap: 1px; font-size: 16cqw; font-weight: 800; color: #a8781a; }
+.gm-card-crowns .gm-crown-icon { width: 20cqw; height: 15cqw; }
+.gm-card-bonus { margin-left: auto; display: flex; gap: 1px; }
+.gm-card-bonus .gm-gem { width: 26cqw; height: 26cqw; }
+.gm-joker-mark { font-size: 16cqw; font-weight: 800; color: #8678A0; }
+.gm-card-art { position: absolute; right: -14%; bottom: 10%; width: 64%; height: auto; opacity: .16; border-width: 0; }
+.gm-ability {
+  position: absolute;
+  right: 3cqw;
+  top: 31%;
+  padding: 0 4cqw;
+  border: 1px solid rgba(92, 84, 99, .25);
+  background: #fff;
+  font-size: 15cqw;
+  font-weight: 700;
+  white-space: nowrap;
+}
+.gm-cost { position: absolute; left: 3cqw; bottom: 3cqw; display: flex; flex-direction: column-reverse; gap: 2cqw; }
+.gm-cost-dot {
+  width: 24cqw;
+  height: 24cqw;
+  display: grid;
+  place-items: center;
+  border: 1px solid var(--gm-lo);
+  border-radius: 50%;
+  background: var(--gm-mid);
+  color: var(--gm-ink);
+  font-size: 16cqw;
+  font-weight: 800;
+  line-height: 1;
+}
+.gm-cost-dot.is-short { box-shadow: 0 0 0 2px #c0473b; }
+.gm-level { position: absolute; right: 4cqw; bottom: 3cqw; font-size: 10cqw; letter-spacing: 1px; color: #9a90a4; }
+.gm-card.is-back .gm-level { position: static; font-size: 14cqw; color: #5d4f73; }
+
+.gm-card.is-small { width: 46px; flex: none; }
+.gm-card.is-large { width: 108px; flex: none; }
+
+/* ---------- 宝石盘 ---------- */
+.gm-board-zone { display: grid; grid-template-columns: minmax(0, 1fr) 62px; gap: 8px; align-items: center; }
+.gm-gem-board {
+  width: min(100%, 300px);
+  justify-self: center;
+  padding: 6px;
+  display: grid;
+  grid-template-columns: repeat(5, minmax(0, 1fr));
+  gap: 4px;
+  border: 3px solid var(--purple-dark, #9B8DB5);
+  background:
+    radial-gradient(circle at 50% 50%, #fff 0 18%, transparent 19%),
+    #efe7f4;
+  box-shadow: 3px 3px 0 rgba(155, 141, 181, .3);
+}
+.gm-cell {
+  position: relative;
+  min-width: 44px;
+  min-height: 44px;
+  aspect-ratio: 1;
+  padding: 4px;
+  display: grid;
+  place-items: center;
+  border: 1px solid rgba(155, 141, 181, .4);
+  border-radius: 50%;
+  background: rgba(255, 255, 255, .7);
+  touch-action: manipulation;
+}
+.gm-cell:disabled { opacity: 1; cursor: default; }
+.gm-cell.is-empty { background: rgba(255, 255, 255, .35); border-style: dashed; }
+.gm-cell.is-selected { box-shadow: 0 0 0 3px var(--purple-darker, #8678A0); background: #fff; }
+.gm-cell.is-selected .gm-gem { transform: scale(1.08); }
+.gm-cell.is-option { box-shadow: 0 0 0 3px #f0c95a; animation: gm-pulse 1.3s ease-in-out infinite; }
+@keyframes gm-pulse { 50% { box-shadow: 0 0 0 3px rgba(240, 201, 90, .25); } }
+
+.gm-board-side { display: grid; gap: 6px; justify-items: stretch; }
+.gm-side-box {
+  padding: 4px;
+  display: grid;
+  justify-items: center;
+  border: 2px solid var(--purple-light, #E6DFF0);
+  background: #fff;
+  font-size: 10px;
+  color: #8d8297;
+}
+.gm-side-box strong { display: inline-flex; align-items: center; gap: 3px; color: var(--text, #5C5463); font-size: 15px; }
+.gm-side-note { font-size: 10px; color: #c0473b; text-align: center; }
+
+/* ---------- 终局复盘 ---------- */
+.gm-review { padding: 7px 8px; display: grid; gap: 6px; border: 2px dashed var(--pink, #E6A8B1); background: #fff; }
+.gm-review-row { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
+
+/* ---------- 操作区 ---------- */
+.gm-controls { display: grid; gap: 7px; padding-top: 4px; }
+.gm-prompt { margin: 0; font-size: 13px; min-height: 18px; }
+.gm-warn { color: #c0473b; }
+.gm-actions { display: flex; gap: 8px; }
+.gm-actions .gm-button {
+  flex: 1 1 0;
+  min-width: 0;
+  min-height: 44px;
+  padding: 6px 8px;
+  font: 700 13px/1.25 system-ui, -apple-system, "PingFang SC", sans-serif;
+  white-space: normal;
+  touch-action: manipulation;
+}
+.gm-actions .gm-primary { color: #fff; background: var(--pink, #E6A8B1); border-color: var(--pink-dark, #C28B93); }
+.gm-actions .gm-button:disabled { opacity: .45; }
+.gm-choices { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
+.gm-choice {
+  min-height: 44px;
+  padding: 4px 10px;
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  border: 2px solid var(--purple-light, #E6DFF0);
+  background: #fff;
+  color: var(--text, #5C5463);
+  font: 700 13px/1 system-ui, sans-serif;
+  touch-action: manipulation;
+}
+.gm-choice.is-selected { border-color: var(--purple-darker, #8678A0); background: var(--purple-light, #E6DFF0); }
+.gm-detail { display: flex; gap: 10px; align-items: flex-start; }
+.gm-detail-info { min-width: 0; display: grid; gap: 3px; font-size: 12px; }
+.gm-detail-info strong { font-size: 14px; }
+
+@media (max-width: 599px) {
+  .board.gem_merchant { width: 100%; max-width: 100%; }
+  .gm-game { gap: 7px; }
+  .gm-meter { min-width: 34px; }
+  .gm-royal-ability { display: none; }
+  .gm-royal-short { display: block; }
+  .gm-royal { min-height: 40px; padding: 3px; column-gap: 3px; }
+  .gm-royal-emblem { width: 16px; height: 16px; font-size: 10px; }
+  .gm-royal-name { font-size: 10px; }
+}
+
+@media (max-width: 359px) {
+  .gm-cell { min-width: 38px; min-height: 38px; padding: 3px; }
+  .gm-board-zone { grid-template-columns: minmax(0, 1fr) 52px; }
+  .gm-token-chip { min-width: 24px; }
+}
diff --git a/app/static/games/gem_merchant.js b/app/static/games/gem_merchant.js
new file mode 100644
index 0000000..ccf9d87
--- /dev/null
+++ b/app/static/games/gem_merchant.js
@@ -0,0 +1,811 @@
+(function registerGemMerchant() {
+  "use strict";
+
+  // 宝石商人：服务端 legal_actions 是唯一权威。这里只做展示、草稿选择和
+  // “当前选择是否等于某个合法动作”的比对，不在浏览器复制规则。
+  const STYLE_ID = "duel-game-gem-merchant-styles";
+  const STYLE_HREF = "/static/games/gem_merchant.css?v=1";
+  const GEMS = ["white", "blue", "green", "red", "black"];
+  const TOKENS = [...GEMS, "pearl", "gold"];
+  const LABELS = {
+    white: "白", blue: "蓝", green: "绿", red: "红", black: "黑", pearl: "珍珠", gold: "金",
+  };
+  const ABILITY_SHORT = {extra_turn: "再来", take_gem: "+同色", steal: "偷1", privilege: "+券"};
+  const ABILITY_LONG = {
+    extra_turn: "再来一回合",
+    take_gem: "从盘上拿 1 枚同色宝石",
+    steal: "从对手拿 1 枚宝石或珍珠",
+    privilege: "拿 1 张特权券",
+  };
+  const LEVELS = {1: "一级", 2: "二级", 3: "三级"};
+  const ROYAL_MARKS = {1: "冠", 2: "影", 3: "风", 4: "卷"};
+
+  function el(doc, tag, cls, text) {
+    const node = doc.createElement(tag);
+    if (cls) node.className = cls;
+    if (text !== undefined && text !== null) node.textContent = String(text);
+    if (tag === "button") node.type = "button";
+    return node;
+  }
+
+  function ensureStylesheet(doc) {
+    if (!doc || !doc.head) return null;
+    const existing = typeof doc.getElementById === "function" ? doc.getElementById(STYLE_ID) : null;
+    if (existing) return existing;
+    const link = doc.createElement("link");
+    link.id = STYLE_ID;
+    link.rel = "stylesheet";
+    link.href = STYLE_HREF;
+    link.dataset.duelGameStyle = "gem_merchant";
+    doc.head.appendChild(link);
+    return link;
+  }
+
+  const cellName = (cell) => `${"ABCDE"[cell[0]]}${cell[1] + 1}`;
+  const sameCell = (a, b) => Boolean(a && b && a[0] === b[0] && a[1] === b[1]);
+  const sortCells = (cells) => [...cells].sort((a, b) => a[0] - b[0] || a[1] - b[1]);
+  const cellsKey = (cells) => sortCells(cells).map((c) => c.join(",")).join(";");
+
+  function draft(context) {
+    if (!context.uiState.gm) {
+      context.uiState.gm = {
+        mode: null, sel: [], gold: null, card: null, deck: null,
+        joker: null, pick: null, busy: false, error: "",
+      };
+    }
+    return context.uiState.gm;
+  }
+
+  function legal(context) {
+    const list = context.legalActions || (context.privateState || {}).legal_actions;
+    return Array.isArray(list) ? list : [];
+  }
+
+  function viewerId(context) {
+    return (context.viewer && context.viewer.player_id) || "";
+  }
+
+  function order(context) {
+    const ids = context.state.participant_order || [];
+    const me = viewerId(context);
+    if (!ids.includes(me)) return [ids[1], ids[0]].filter(Boolean);
+    return [ids.find((id) => id !== me), me];
+  }
+
+  function nameOf(context, playerId) {
+    const participant = (context.participants || []).find((p) => p.player_id === playerId);
+    return participant ? (participant.display_name || participant.player_id) : (playerId || "玩家");
+  }
+
+  function isTerminal(context) {
+    return Boolean(
+      context.isTerminal || context.state.result
+      || ((context.state.flow || {}).phase === "finished")
+      || ["finished", "archived"].includes((context.room || {}).status)
+    );
+  }
+
+  function myTurn(context) {
+    return Boolean(context.canMove && !isTerminal(context) && legal(context).length);
+  }
+
+  function rerender(context) {
+    if (context.helpers && typeof context.helpers.rerender === "function") context.helpers.rerender();
+  }
+
+  function submit(context, move) {
+    const ui = draft(context);
+    if (ui.busy) return;
+    if (context.helpers.canMove && !context.helpers.canMove()) return;
+    ui.busy = true;
+    ui.error = "";
+    rerender(context);
+    Promise.resolve(context.helpers.submitMove(move)).then((ok) => {
+      ui.busy = false;
+      if (!ok) rerender(context);
+    }, () => {
+      ui.busy = false;
+      rerender(context);
+    });
+  }
+
+  function reset(context) {
+    const ui = draft(context);
+    Object.assign(ui, {mode: null, sel: [], gold: null, card: null, deck: null, joker: null, pick: null, error: ""});
+  }
+
+  // ---------------------------------------------------------------- 画面零件
+
+  function gem(doc, color, extra) {
+    const node = el(doc, "span", `gm-gem gem-${color}${extra ? ` ${extra}` : ""}`);
+    node.appendChild(el(doc, "span", "gm-facet"));
+    node.setAttribute("aria-hidden", "true");
+    return node;
+  }
+
+  function crownIcon(doc) {
+    const node = el(doc, "span", "gm-crown-icon");
+    node.setAttribute("aria-hidden", "true");
+    return node;
+  }
+
+  function scrollIcon(doc) {
+    const node = el(doc, "span", "gm-scroll-icon");
+    node.setAttribute("aria-hidden", "true");
+    return node;
+  }
+
+  function cardText(card) {
+    if (!card || card.hidden) return `${LEVELS[card && card.level] || ""}盲抽卡（对手看不到）`;
+    const kind = card.joker ? (card.as ? `百搭（作${LABELS[card.as]}）` : "百搭") : card.color ? `${LABELS[card.color]}色` : "纯分";
+    const bits = [`${LEVELS[card.level]}${kind}卡 #${card.id}`, `${card.points} 分`];
+    if (card.crowns) bits.push(`${card.crowns} 顶皇冠`);
+    if (card.bonus === 2) bits.push("双加成");
+    if (card.ability) bits.push(ABILITY_LONG[card.ability]);
+    const cost = TOKENS.filter((t) => card.cost && card.cost[t]).map((t) => `${LABELS[t]}${card.cost[t]}`);
+    bits.push(`成本 ${cost.join(" ") || "0"}`);
+    return bits.join("，");
+  }
+
+  function cardNode(doc, card, options = {}) {
+    const tag = options.onClick ? "button" : "div";
+    if (!card) {
+      const empty = el(doc, "div", "gm-card is-empty");
+      empty.setAttribute("aria-label", "空位");
+      return empty;
+    }
+    if (card.hidden) {
+      const back = el(doc, tag, `gm-card is-back lv-${card.level}`);
+      if (options.size) back.classList.add(`is-${options.size}`);
+      back.appendChild(el(doc, "span", "gm-back-mark", "盲抽"));
+      back.appendChild(el(doc, "span", "gm-level", "◆".repeat(card.level || 1)));
+      back.setAttribute("aria-label", cardText(card));
+      if (options.onClick) back.addEventListener("click", options.onClick);
+      return back;
+    }
+    const tint = card.joker && !card.as ? "is-joker" : `tint-${card.as || card.color || "none"}`;
+    const node = el(doc, tag, `gm-card lv-${card.level} ${tint}`);
+    if (options.size) node.classList.add(`is-${options.size}`);
+    if (options.buyable) node.classList.add("can-buy");
+    if (options.focused) node.classList.add("is-focused");
+    if (options.reservable) node.classList.add("can-reserve");
+    node.dataset.cardId = String(card.id);
+    const top = el(doc, "span", "gm-card-top");
+    top.appendChild(el(doc, "span", `gm-points${card.points ? "" : " is-zero"}`, card.points || ""));
+    if (card.crowns) {
+      const crowns = el(doc, "span", "gm-card-crowns");
+      crowns.appendChild(crownIcon(doc));
+      if (card.crowns > 1) crowns.appendChild(el(doc, "span", "", card.crowns));
+      top.appendChild(crowns);
+    }
+    const bonus = el(doc, "span", "gm-card-bonus");
+    if (card.joker && !card.as) {
+      bonus.appendChild(el(doc, "span", "gm-joker-mark", "百搭"));
+    } else if (card.as || card.color) {
+      for (let i = 0; i < (card.bonus || 0); i += 1) bonus.appendChild(gem(doc, card.as || card.color, "is-mini"));
+    }
+    top.appendChild(bonus);
+    node.appendChild(top);
+    // 原创底纹：每种颜色一枚大号淡色宝石轮廓。
+    if (card.as || card.color) node.appendChild(gem(doc, card.as || card.color, "gm-card-art"));
+    if (card.ability) node.appendChild(el(doc, "span", "gm-ability", ABILITY_SHORT[card.ability]));
+    const cost = el(doc, "span", "gm-cost");
+    TOKENS.filter((t) => card.cost && card.cost[t]).forEach((t) => {
+      const dot = el(doc, "span", `gm-cost-dot gem-${t}`, card.cost[t]);
+      if (options.short && options.short[t]) dot.classList.add("is-short");
+      cost.appendChild(dot);
+    });
+    node.appendChild(cost);
+    node.appendChild(el(doc, "span", "gm-level", "◆".repeat(card.level)));
+    node.setAttribute("aria-label", cardText(card));
+    if (options.onClick) node.addEventListener("click", options.onClick);
+    return node;
+  }
+
+  function royalNode(doc, royal, options = {}) {
+    const node = el(doc, options.onClick ? "button" : "div", "gm-royal");
+    if (options.selected) node.classList.add("is-selected");
+    node.dataset.royalId = String(royal.id);
